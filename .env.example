# Application
NEXT_PUBLIC_APP_URL=https://gaptuber.app
AUTH_SECRET=generate-at-least-32-random-characters

# Database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Google OAuth + YouTube
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=

# AI provider (required by the current generation routes)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# 64 hexadecimal characters; changing this after storing tokens makes them unreadable
TOKEN_ENCRYPTION_KEY=

# Distributed cache, rate limiting, and webhook idempotency
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduled outcome collection; use at least 32 random characters
CRON_SECRET=

# Razorpay (configure all three if Razorpay checkout is enabled)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Lemon Squeezy (configure the API/store/webhook values and every offered plan)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_LITE_VARIANT_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_LIFETIME_VARIANT_ID=

# Filmot caption search (optional — find topics spoken inside videos but not in titles)
# Free API key at https://filmot.com/api
FILMOT_API_KEY=

# Exa neural web search grounding (optional — validate gap ideas against current web trends)
# Free tier at https://exa.ai ($10 free credits)
EXA_API_KEY=

# Observability
NEXT_PUBLIC_SENTRY_DSN=
